APP_NAME="RAG-Hr-Assistant"
APP_VERSION="0.1"

# ========================= Security Config =========================
# Shared API key for local use. Leave empty only for trusted local development.
API_KEY="CHANGE_ME"
METRICS_PATH="/metrics"

FILE_ALLOWED_TYPES=["text/plain", "application/pdf"]
FILE_MAX_SIZE=10
FILE_DEFAULT_CHUNK_SIZE=512000

POSTGRES_USERNAME="postgres"
POSTGRES_PASSWORD="CHANGE_ME"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_MAIN_DATABASE="minihr"

# ========================= LLM Config =========================
GENERATION_BACKEND="OPENAI"
EMBEDDING_BACKEND="COHERE"

OPENAI_API_KEY="sk-your-openai-key"
OPENAI_API_URL=""
COHERE_API_KEY="your-cohere-key"

GENERATION_MODEL_ID_LITERAL=["gpt-4o-mini", "gpt-4o"]
GENERATION_MODEL_ID="gpt-4o-mini"
EMBEDDING_MODEL_ID="embed-multilingual-v3.0"
EMBEDDING_MODEL_SIZE=1024

INPUT_DAFAULT_MAX_CHARACTERS=1024
GENERATION_DAFAULT_MAX_TOKENS=200
GENERATION_DAFAULT_TEMPERATURE=0.1

# ========================= Vector DB Config =========================
VECTOR_DB_BACKEND_LITERAL=["QDRANT", "PGVECTOR"]
VECTOR_DB_BACKEND="PGVECTOR"
VECTOR_DB_PATH="qdrant_db"
VECTOR_DB_DISTANCE_METHOD="cosine"
VECTOR_DB_PGVEC_INDEX_THRESHOLD=100
# Leave empty to use the local on-disk Qdrant database at VECTOR_DB_PATH.
# Set to e.g. "http://localhost:6333" to use a Qdrant server instead.
QDRANT_URL=""
QDRANT_API_KEY=""

# ========================= Template Config =========================
PRIMARY_LANG="en"
DEFAULT_LANG="en"

# ========================= Retrieval Config =========================
# Answers are refused when the best retrieval score is below this value.
MIN_RETRIEVAL_SCORE=0.25

# ========================= Celery Task Queue Config =========================
CELERY_BROKER_URL="amqp://CHANGE_ME_USER:CHANGE_ME@localhost:5672/CHANGE_ME_VHOST"
CELERY_RESULT_BACKEND="redis://:CHANGE_ME@localhost:6379/0"
CELERY_TASK_SERIALIZER="json"
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_ACKS_LATE=false
CELERY_WORKER_CONCURRENCY=2
CELERY_FLOWER_PASSWORD="CHANGE_ME"
FLOWER_AUTH_USER="admin"
